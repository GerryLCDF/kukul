{
  "name": "kukul",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Colección de animaciones de UI con React + Framer Motion, documentadas y configurables.",
  "keywords": ["react", "framer-motion", "animations", "ui"],
  "license": "MIT",
  "main": "./dist/kukul.cjs",
  "module": "./dist/kukul.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/kukul.js",
      "require": "./dist/kukul.cjs"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:lib": "vite build --config vite.lib.config.ts",
    "preview": "vite preview",
    "prepublishOnly": "npm run build:lib"
  },
  "peerDependencies": {
    "framer-motion": "^11.11.17",
    "lucide-react": "^1.47.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "framer-motion": "^11.11.17",
    "lucide-react": "^1.47.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-dts": "^5.1.1"
  }
}